# Copie para .env e preencha. NUNCA comite .env (regra inviolável 1).

# ---------------------------------------------------------------------------
# DataJud (CNJ) — API Pública
# ---------------------------------------------------------------------------
# A chave é pública e compartilhada por todos os consumidores, mas mesmo assim
# não vai hardcoded no repositório: o CNJ pode rotacioná-la sem aviso e queremos
# um único lugar para trocar.
#
# Chave vigente publicada em: https://datajud-wiki.cnj.jus.br/api-publica/acesso
# Informe SÓ o valor da chave, sem o prefixo "APIKey ".
DATAJUD_API_KEY=

# Opcional. Sobrescreva para apontar a um mock local em testes.
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Intervalo mínimo entre requisições, em ms (regra inviolável 2: 1 req/s por padrão).
DATAJUD_MIN_INTERVALO_MS=1100
